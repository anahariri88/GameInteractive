// ============================================================
//  STATE GAME
// ============================================================
let state = {
    mode: 'quick',
    age: 7,
    questions: [],
    currentIndex: 0,
    score: 0,
    stars: 0,
    correctCount: 0,
    wrongCount: 0,
    streak: 0,
    timer: 20,
    timerInterval: null,
    answered: false,
    totalQuestions: 0,
    startTime: null,
    endTime: null,
    badges: []
};

// ============================================================
//  DOM REFS
// ============================================================
const $ = id => document.getElementById(id);
const menuScreen = $('menuScreen');
const gameScreen = $('gameScreen');
const endScreen = $('endScreen');
const questionText = $('questionText');
const optionsBtns = document.querySelectorAll('.option-btn');
const feedbackText = $('feedbackText');
const feedbackBox = $('feedbackBox');
const nextBtn = $('nextBtn');
const quitBtn = $('quitBtn');
const scoreDisplay = $('scoreDisplay');
const starCount = $('starCount');
const questionCounter = $('questionCounter');
const progressFill = $('progressFill');
const timerDisplay = $('timerDisplay');
const modeLabel = $('modeLabel');
const finalScore = $('finalScore');
const finalCorrect = $('finalCorrect');
const finalWrong = $('finalWrong');
const finalStars = $('finalStars');
const finalTime = $('finalTime');
const badgeContainer = $('badgeContainer');

// ============================================================
//  FUNGSI UTAMA
// ============================================================
function shuffleArray(arr) {
    for (let i = arr.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [arr[i], arr[j]] = [arr[j], arr[i]];
    }
    return arr;
}

function getQuestionsForMode(mode) {
    let pool = [];
    if (mode === 'quick') {
        const all = [...SOALAN.math, ...SOALAN.bm, ...SOALAN.eng, ...SOALAN.sains];
        pool = shuffleArray(all).slice(0, 10);
    } else if (mode === 'daily') {
        const all = [...SOALAN.math, ...SOALAN.bm, ...SOALAN.eng, ...SOALAN.sains];
        pool = shuffleArray(all).slice(0, 5);
    } else if (SOALAN[mode]) {
        pool = shuffleArray([...SOALAN[mode]]);
    } else {
        pool = [];
    }
    return pool;
}

function startGame(mode, age) {
    state.mode = mode;
    state.age = age;
    state.currentIndex = 0;
    state.score = 0;
    state.stars = 0;
    state.correctCount = 0;
    state.wrongCount = 0;
    state.streak = 0;
    state.answered = false;
    state.badges = [];
    state.startTime = Date.now();

    const allQuestions = getQuestionsForMode(mode);
    if (mode === 'quick') {
        state.questions = allQuestions;
        state.totalQuestions = 10;
    } else if (mode === 'daily') {
        state.questions = allQuestions;
        state.totalQuestions = 5;
    } else {
        state.questions = allQuestions;
        state.totalQuestions = Math.min(allQuestions.length, 100);
        state.questions = allQuestions.slice(0, state.totalQuestions);
    }

    if (state.questions.length === 0) {
        alert("Maaf, tiada soalan untuk mode ini. Cuba mode lain.");
        return;
    }

    const modeNames = { quick:'Quick', math:'Matematik', bm:'BM', eng:'English', sains:'Sains', daily:'Daily' };
    modeLabel.textContent = modeNames[mode] || mode;

    menuScreen.classList.add('hidden');
    gameScreen.classList.remove('hidden');
    endScreen.classList.add('hidden');

    renderQuestion();
}

function renderQuestion() {
    const qs = state.questions;
    if (state.currentIndex >= qs.length || qs.length === 0) {
        endGame();
        return;
    }

    const q = qs[state.currentIndex];
    questionText.textContent = q.q;

    const shuffled = q.options.map((opt, idx) => ({ text: opt, isCorrect: idx === q.ans }));
    const shuffledOptions = shuffleArray([...shuffled]);
    const correctIndex = shuffledOptions.findIndex(item => item.isCorrect === true);
    state._correctIndex = correctIndex;

    optionsBtns.forEach((btn, idx) => {
        btn.textContent = shuffledOptions[idx].text;
        btn.className = 'option-btn';
        btn.dataset.correct = (idx === correctIndex) ? 'true' : 'false';
        btn.disabled = false;
    });

    feedbackBox.className = 'feedback-box';
    feedbackText.textContent = 'Pilih jawapan!';
    feedbackBox.querySelector('i').className = 'fas fa-lightbulb';
    nextBtn.disabled = true;
    state.answered = false;

    questionCounter.textContent = `Soalan ${state.currentIndex+1}/${state.totalQuestions}`;
    progressFill.style.width = `${((state.currentIndex) / state.totalQuestions) * 100}%`;
    scoreDisplay.textContent = state.score;
    starCount.textContent = state.stars;

    let seconds = 20;
    if (state.age <= 8) seconds = 15;
    else if (state.age <= 10) seconds = 20;
    else seconds = 30;
    if (state.mode === 'bm' || state.mode === 'eng') seconds += 5;
    state.timer = seconds;
    timerDisplay.textContent = seconds + 's';
    timerDisplay.style.color = '#a0522d';

    clearInterval(state.timerInterval);
    state.timerInterval = setInterval(() => {
        state.timer--;
        timerDisplay.textContent = state.timer + 's';
        if (state.timer <= 5) timerDisplay.style.color = '#d32f2f';
        if (state.timer <= 0) {
            clearInterval(state.timerInterval);
            if (!state.answered) {
                state.answered = true;
                state.wrongCount++;
                state.streak = 0;
                feedbackBox.className = 'feedback-box';
                feedbackBox.querySelector('i').className = 'fas fa-hourglass-end';
                feedbackText.textContent = '⏰ Masa tamat! Cuba lagi 😊';
                optionsBtns.forEach((btn, idx) => {
                    btn.disabled = true;
                    if (btn.dataset.correct === 'true') btn.classList.add('correct');
                });
                nextBtn.disabled = false;
                timerDisplay.textContent = '0s';
            }
        }
    }, 1000);
}

function handleOptionClick(e) {
    const btn = e.currentTarget;
    if (state.answered || btn.disabled) return;
    clearInterval(state.timerInterval);
    state.answered = true;

    const isCorrect = btn.dataset.correct === 'true';
    if (isCorrect) {
        state.correctCount++;
        state.score += 10;
        state.streak++;
        if (state.streak >= 3) {
            state.score += 5;
            state.stars += 1;
            feedbackText.textContent = '🔥 Streak! +5 bonus!';
        } else {
            feedbackText.textContent = 'Betul! 🎉';
        }
        if (state.timer > 10) {
            state.score += 3;
            feedbackText.textContent += ' +3 cepat!';
        }
        if (state.correctCount % 3 === 0) state.stars += 1;

        btn.classList.add('correct');
        feedbackBox.querySelector('i').className = 'fas fa-check-circle';
        feedbackBox.className = 'feedback-box correct';
        const q = state.questions[state.currentIndex];
        const correctText = q.options[q.ans];
        feedbackText.textContent = `✅ Betul! Jawapan: ${correctText}`;
    } else {
        state.wrongCount++;
        state.streak = 0;
        btn.classList.add('wrong');
        feedbackBox.querySelector('i').className = 'fas fa-times-circle';
        feedbackBox.className = 'feedback-box wrong';
        optionsBtns.forEach(b => {
            if (b.dataset.correct === 'true') b.classList.add('correct');
        });
        const q = state.questions[state.currentIndex];
        const correctText = q.options[q.ans];
        feedbackText.textContent = `😊 Hampir! Jawapan betul: ${correctText}`;
    }

    optionsBtns.forEach(b => b.disabled = true);
    scoreDisplay.textContent = state.score;
    starCount.textContent = state.stars;
    nextBtn.disabled = false;
}

function nextQuestion() {
    state.currentIndex++;
    if (state.currentIndex >= state.totalQuestions) {
        endGame();
    } else {
        renderQuestion();
    }
}

function endGame() {
    clearInterval(state.timerInterval);
    state.endTime = Date.now();
    const totalSec = Math.floor((state.endTime - state.startTime) / 1000);

    const badges = [];
    if (state.correctCount >= state.totalQuestions * 0.8) badges.push('🏆 Super Learner');
    if (state.mode === 'math' && state.correctCount >= state.totalQuestions * 0.6) badges.push('🧮 Math Hero');
    if (state.mode === 'sains' && state.correctCount >= state.totalQuestions * 0.6) badges.push('🔬 Science Explorer');
    if (state.mode === 'eng' && state.correctCount >= state.totalQuestions * 0.6) badges.push('🌟 English Star');
    if (state.mode === 'bm' && state.correctCount >= state.totalQuestions * 0.6) badges.push('📚 BM Master');
    if (state.stars >= 3) badges.push('⭐ Bintang Bijak');
    if (badges.length === 0) badges.push('🌱 Pelajar Gigih');

    state.badges = badges;

    gameScreen.classList.add('hidden');
    endScreen.classList.remove('hidden');

    finalScore.textContent = state.score;
    finalCorrect.textContent = state.correctCount;
    finalWrong.textContent = state.wrongCount;
    finalStars.textContent = state.stars;
    finalTime.textContent = totalSec;

    badgeContainer.innerHTML = badges.map(b => `<span class="badge-item"><i class="fas fa-medal"></i> ${b}</span>`).join('');
}

function resetToMenu() {
    clearInterval(state.timerInterval);
    gameScreen.classList.add('hidden');
    endScreen.classList.add('hidden');
    menuScreen.classList.remove('hidden');
}

// ============================================================
//  EVENT BINDING
// ============================================================
optionsBtns.forEach(btn => btn.addEventListener('click', handleOptionClick));
nextBtn.addEventListener('click', nextQuestion);
quitBtn.addEventListener('click', resetToMenu);
$('playAgainBtn').addEventListener('click', () => {
    endScreen.classList.add('hidden');
    startGame(state.mode, state.age);
});
$('endMenuBtn').addEventListener('click', resetToMenu);

// Pilihan umur
document.querySelectorAll('.age-btn').forEach(btn => {
    btn.addEventListener('click', function() {
        document.querySelectorAll('.age-btn').forEach(b => b.classList.remove('active'));
        this.classList.add('active');
        state.age = parseInt(this.dataset.age);
    });
});
document.querySelector('.age-btn[data-age="7"]').classList.add('active');

// Mode cards
document.querySelectorAll('.mode-card').forEach(card => {
    card.addEventListener('click', function() {
        document.querySelectorAll('.mode-card').forEach(c => c.classList.remove('selected'));
        this.classList.add('selected');
        state.mode = this.dataset.mode;
    });
});

// Start button
$('startGameBtn').addEventListener('click', function() {
    if (!state.mode) state.mode = 'quick';
    startGame(state.mode, state.age);
});

// ============================================================
//  INISIALISASI
// ============================================================
menuScreen.classList.remove('hidden');
gameScreen.classList.add('hidden');
endScreen.classList.add('hidden');
console.log('🚀 EduQuest FULL VERSION sedia! 100 soalan setiap subjek.');
