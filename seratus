            <div class="mode-card" data-mode="bm"><i class="fas fa-language"></i> BM</div>
            <div class="mode-card" data-mode="eng"><i class="fas fa-font"></i> English</div>
            <div class="mode-card" data-mode="sains"><i class="fas fa-flask"></i> Sains</div>
            <div class="mode-card" data-mode="daily"><i class="fas fa-calendar-day"></i> Daily</div>
        </div>
        <div style="margin: 14px 0;">
            <button class="btn btn-success" id="startGameBtn"><i class="fas fa-play"></i> Mula!</button>
        </div>
        <div style="font-size:0.9rem; background:#f5e4c2; border-radius:40px; padding:10px;">
            <i class="fas fa-star" style="color:#f5a623;"></i> 100 soalan setiap subjek | Pembelajaran interaktif
        </div>
    </div>

    <!-- SKRIN GAME -->
    <div id="gameScreen" class="hidden">
        <div class="header">
            <div class="avatar-box"><i class="fas fa-user-astronaut"></i> <span id="playerName">Peneroka</span></div>
            <div class="stars-box"><i class="fas fa-star"></i> <span id="starCount">0</span></div>
            <div class="score-box"><i class="fas fa-trophy"></i> <span id="scoreDisplay">0</span></div>
        </div>
        <div class="progress-area">
            <span id="questionCounter">Soalan 1/10</span>
            <span id="modeLabel">Quick</span>
        </div>
        <div class="progress-bar-bg"><div class="progress-fill" id="progressFill"></div></div>

        <div class="question-box">
            <div class="question-text" id="questionText">Soalan akan muncul di sini</div>
            <div class="timer-box"><i class="fas fa-hourglass-half"></i> <span class="timer-circle" id="timerDisplay">20s</span></div>
        </div>

        <div class="options-grid" id="optionsContainer">
            <button class="option-btn" data-index="0">A</button>
            <button class="option-btn" data-index="1">B</button>
            <button class="option-btn" data-index="2">C</button>
            <button class="option-btn" data-index="3">D</button>
        </div>

        <div class="feedback-box" id="feedbackBox"><i class="fas fa-lightbulb"></i> <span id="feedbackText">Pilih jawapan!</span></div>

        <div class="action-bar">
            <button class="btn btn-secondary btn-small" id="quitBtn"><i class="fas fa-home"></i> Menu</button>
            <button class="btn btn-small" id="nextBtn" disabled><i class="fas fa-arrow-right"></i> Seterusnya</button>
        </div>
    </div>

    <!-- SKRIN TAMAT -->
    <div id="endScreen" class="end-screen hidden">
        <div class="big-icon">🎉</div>
        <h2 style="font-size:2.2rem; color:#3d2b1a;">Tahniah!</h2>
        <div style="font-size:1.2rem; margin:8px 0;">Anda hebat!</div>
        <div class="badge-container" id="badgeContainer"></div>
        <div style="background:#f5e4c2; border-radius:40px; padding:16px; margin:12px 0;">
            <p><i class="fas fa-star"></i> Markah: <strong id="finalScore">0</strong></p>
            <p>✅ Betul: <span id="finalCorrect">0</span> &nbsp;|&nbsp; ❌ Salah: <span id="finalWrong">0</span></p>
            <p>⭐ Bintang: <span id="finalStars">0</span> &nbsp;|&nbsp; 🕒 Masa: <span id="finalTime">0</span>s</p>
        </div>
        <div class="flex-center">
            <button class="btn" id="playAgainBtn"><i class="fas fa-redo"></i> Main Lagi</button>
            <button class="btn btn-secondary" id="endMenuBtn"><i class="fas fa-home"></i> Menu</button>
        </div>
        <p style="margin-top:14px; font-weight:600;">Hebat! Teruskan belajar dan cuba pecahkan rekod anda!</p>
    </div>
</div>

