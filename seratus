            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: 'Quicksand', sans-serif;
            background: linear-gradient(145deg, #f9e8b4 0%, #f4d78a 100%);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 16px;
        }
        .game-container {
            max-width: 520px;
            width: 100%;
            background: #fff8e7;
            border-radius: 48px 48px 32px 32px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.2), 0 8px 16px rgba(0,0,0,0.1);
            padding: 24px 20px 32px;
            position: relative;
            transition: all 0.2s;
            border: 4px solid #ffb347;
        }
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: #ffcf8a;
            padding: 10px 16px;
            border-radius: 60px;
            margin-bottom: 20px;
            color: #3d2b1a;
            font-weight: 700;
            font-size: 1rem;
            flex-wrap: wrap;
        }
        .avatar-box {
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .avatar-box i {
            font-size: 2rem;
            color: #5d3a1a;
            background: #ffe3b0;
            padding: 6px;
            border-radius: 50%;
        }
        .stars-box {
            background: #fcedb3;
            padding: 4px 14px;
            border-radius: 30px;
            font-size: 1.2rem;
            color: #b8860b;
        }
        .score-box {
            background: #4a7c59;
            color: white;
            padding: 4px 14px;
            border-radius: 30px;
        }
        .progress-area {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 10px;
            font-weight: 600;
            color: #4d3e2b;
        }
        .progress-bar-bg {
            width: 100%;
            height: 14px;
            background: #e5d5b0;
            border-radius: 30px;
            margin: 6px 0 18px;
            overflow: hidden;
        }
        .progress-fill {
            height: 100%;
            width: 0%;
            background: linear-gradient(90deg, #f9b83a, #f5a623);
            border-radius: 30px;
            transition: width 0.2s;
        }
        .question-box {
            background: white;
            border-radius: 40px;
            padding: 20px 18px;
            box-shadow: inset 0 4px 8px rgba(0,0,0,0.02), 0 8px 18px rgba(0,0,0,0.05);
            margin-bottom: 18px;
        }
        .question-text {
            font-size: 1.5rem;
            font-weight: 700;
            color: #2f1f0e;
            line-height: 1.4;
            min-height: 80px;
            display: flex;
            align-items: center;
        }
        .timer-box {
            display: flex;
            justify-content: flex-end;
            align-items: center;
            gap: 6px;
            font-size: 1.3rem;
            font-weight: 700;
            color: #a0522d;
            margin-top: 6px;
        }
        .timer-circle {
            background: #e9dac7;
            padding: 2px 14px;
            border-radius: 40px;
        }
        .options-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
            margin: 16px 0 10px;
        }
        .option-btn {
            background: #fef6e9;
            border: 3px solid #dbbd91;
            border-radius: 60px;
            padding: 14px 6px;
            font-size: 1.2rem;
            font-weight: 600;
            color: #2f1f0e;
            transition: all 0.1s ease;
            box-shadow: 0 4px 0 #b3926a;
            cursor: pointer;
            text-align: center;
            word-break: break-word;
        }
        .option-btn:active {
            transform: scale(0.96);
            box-shadow: 0 2px 0 #b3926a;
        }
        .option-btn.correct {
            background: #8bc34a;
            border-color: #558b2f;
            box-shadow: 0 4px 0 #33691e;
            color: white;
        }
        .option-btn.wrong {
            background: #ef9a9a;
            border-color: #c62828;
            box-shadow: 0 4px 0 #b71c1c;
            color: white;
        }
        .option-btn.disabled {
            pointer-events: none;
            opacity: 0.7;
        }
        .feedback-box {
            background: #fcf3e0;
            border-radius: 30px;
            padding: 14px 18px;
            margin: 12px 0 6px;
            font-weight: 600;
            font-size: 1.1rem;
            min-height: 60px;
            display: flex;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
            border-left: 8px solid #f5b342;
        }
        .feedback-box i {
            font-size: 1.8rem;
        }
        .action-bar {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 12px;
            margin-top: 18px;
        }
        .btn {
            background: #ffb74d;
            border: none;
            border-radius: 60px;
            padding: 12px 24px;
            font-weight: 700;
            font-size: 1.1rem;
            color: #2f1f0e;
            box-shadow: 0 6px 0 #c47f2b;
            transition: 0.07s;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            border: 2px solid #f5a623;
        }
        .btn:active {
            transform: translateY(4px);
            box-shadow: 0 2px 0 #c47f2b;
        }
        .btn-secondary {
            background: #b0bec5;
            box-shadow: 0 6px 0 #78909c;
            border-color: #90a4ae;
            color: #1c2a35;
        }
        .btn-success {
            background: #66bb6a;
            box-shadow: 0 6px 0 #2e7d32;
            border-color: #43a047;
            color: white;
        }
        .btn-small {
            padding: 8px 18px;
            font-size: 0.9rem;
        }
        .menu-screen {
            text-align: center;
        }
        .menu-screen h1 {
            font-size: 2.8rem;
            color: #4d2e1b;
            letter-spacing: 2px;
            margin-bottom: 6px;
        }
        .menu-screen .sub {
            font-size: 1.2rem;
            color: #6b4c2c;
            margin-bottom: 24px;
        }
        .age-selector {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 10px;
            margin: 20px 0;
        }
        .age-btn {
            background: #ffd9a3;
            border: 3px solid #b58a5a;
            border-radius: 60px;
            padding: 12px 20px;
            font-weight: 700;
            font-size: 1.1rem;
            cursor: pointer;
            transition: 0.1s;
            color: #2f1f0e;
            flex: 1 0 auto;
            max-width: 140px;
        }
        .age-btn.active {
            background: #f5a623;
            border-color: #7f5700;
            color: white;
            box-shadow: 0 4px 0 #7f5700;
        }
        .mode-grid {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 14px;
            margin: 20px 0;
        }
        .mode-card {
            background: #ffead0;
            border-radius: 30px;
            padding: 18px 6px;
            border: 3px solid #dba16d;
            cursor: pointer;
            transition: 0.1s;
            font-weight: 700;
            font-size: 1rem;
            box-shadow: 0 6px 0 #b87d4b;
        }
        .mode-card:active {
            transform: translateY(4px);
            box-shadow: 0 2px 0 #b87d4b;
        }
        .mode-card i {
            font-size: 2.2rem;
            display: block;
            margin-bottom: 6px;
        }
        .mode-card.selected {
            border-color: #f5a623;
            background: #ffd9a3;
        }
        .end-screen {
            text-align: center;
        }
        .end-screen .big-icon {
            font-size: 4rem;
        }
        .badge-container {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 8px;
            margin: 16px 0;
        }
        .badge-item {
            background: #ffd966;
            padding: 6px 16px;
            border-radius: 40px;
            font-weight: 700;
            font-size: 0.9rem;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            border: 2px solid #b47d44;
        }
        .hidden {
            display: none !important;
        }
        .mt-2 { margin-top: 12px; }
        .mb-1 { margin-bottom: 8px; }
        .text-center { text-align: center; }
        .flex-center { display: flex; justify-content: center; gap: 10px; flex-wrap: wrap; }
        .version-tag {
            background: #4a7c59;
            color: white;
            padding: 4px 16px;
            border-radius: 30px;
            font-size: 0.8rem;
            display: inline-block;
        }
        @media (max-width: 480px) {
            .question-text { font-size: 1.2rem; }
            .option-btn { font-size: 1rem; padding: 12px 4px; }
            .mode-grid { grid-template-columns: 1fr 1fr; }
